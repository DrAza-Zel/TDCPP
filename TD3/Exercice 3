#include <cctype>
#include <iostream>
#include <queue>
#include <stack>
#include <string>
#include <vector>

using namespace std;

bool isPalindrome(const string& input) {
    queue<char> normalOrder;
    stack<char> reverseOrder;

    for (char character : input) {
        if (isalnum(static_cast<unsigned char>(character))) {
            char convertedCharacter =
                static_cast<char>(tolower(character));

            normalOrder.push(convertedCharacter);
            reverseOrder.push(convertedCharacter);
        }
    }

    while (!normalOrder.empty()) {
        if (normalOrder.front() != reverseOrder.top()) {
            return false;
        }

        normalOrder.pop();
        reverseOrder.pop();
    }

    return true;
}

int main() {
    vector<string> words = {"racecar", "hello"};

    cout << boolalpha;

    for (const string& word : words) {
        cout << "Is '" << word << "' a palindrome? "
             << isPalindrome(word) << endl;
    }

    return 0;
}
