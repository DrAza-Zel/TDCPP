#include <algorithm>
#include <iostream>
#include <map>
#include <vector>

using namespace std;

void countFrequencyBruteForce(const vector<int>& numbers) {
    vector<int> displayedNumbers;

    for (int value : numbers) {
        bool alreadyDisplayed =
            find(displayedNumbers.begin(), displayedNumbers.end(), value)
            != displayedNumbers.end();

        if (alreadyDisplayed) {
            continue;
        }

        int frequency = 0;

        for (int number : numbers) {
            if (number == value) {
                frequency++;
            }
        }

        cout << value << " : " << frequency << " times" << endl;
        displayedNumbers.push_back(value);
    }
}

map<int, int> countFrequencyOptimal(const vector<int>& numbers) {
    map<int, int> frequencies;

    for (int value : numbers) {
        frequencies[value]++;
    }

    return frequencies;
}

int main() {
    vector<int> numbers = {1, 2, 3, 2, 4, 1, 5, 5, 6};

    cout << "=== Brute Force ===" << endl;
    countFrequencyBruteForce(numbers);

    cout << "\n=== Optimal ===" << endl;

    map<int, int> frequencies = countFrequencyOptimal(numbers);

    for (const auto& element : frequencies) {
        cout << element.first << " : "
             << element.second << " times" << endl;
    }

    return 0;
}
